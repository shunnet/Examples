<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Snet.DAQ.Samples.DLL\Snet.DAQ.Samples.DLL.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="config\**\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="lib\**\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Snet.Mqtt" Version="26.256.1" />
	  <PackageReference Include="Snet.Opc" Version="26.256.1" />
	</ItemGroup>

</Project>
